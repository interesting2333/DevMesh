    components:
      securitySchemes:
        trustedIdentity:
          type: 'http'
          scheme: 'bearer'
          description: '可信 IdentityResolver 接入点；默认未配置，不签发测试 token、匿名用户或企业登录。CLI 当前没有企业 resolver。'
        browserSession:
          type: 'apiKey'
          in: 'cookie'
          name: 'devmesh_session'
          description: '后续企业浏览器 Session；当前 Cookie 认证未接入，必须另行完成 Origin/CSRF。'
      schemas:
        BeginAcceptance:
          type: 'object'
          properties:
            candidateRevision:
              type: 'integer'
              minimum: 1
              maximum: 9007199254740991
            manifestHash:
              type: 'string'
              pattern: '^[a-f0-9]{64}$'
            reviewHash:
              type: 'string'
              pattern: '^[a-f0-9]{64}$'
            expectedAcceptedReleaseId:
              anyOf:
                0:
                  type: 'string'
                  pattern: '^release_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$'
                1:
                  type: 'null'
            dataPlanHash:
              type: 'string'
              pattern: '^[a-f0-9]{64}$'
            policyHash:
              type: 'string'
              pattern: '^[a-f0-9]{64}$'
          required:
            0: 'candidateRevision'
            1: 'manifestHash'
            2: 'reviewHash'
            3: 'expectedAcceptedReleaseId'
            4: 'dataPlanHash'
            5: 'policyHash'
          additionalProperties: false
        ConfirmAcceptanceReplacement:
          type: 'object'
          properties:
            candidateRevision:
              type: 'integer'
              minimum: 1
              maximum: 9007199254740991
            manifestHash:
              type: 'string'
              pattern: '^[a-f0-9]{64}$'
            reviewHash:
              type: 'string'
              pattern: '^[a-f0-9]{64}$'
            expectedAcceptedReleaseId:
              anyOf:
                0:
                  type: 'string'
                  pattern: '^release_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$'
                1:
                  type: 'null'
            dataPlanHash:
              type: 'string'
              pattern: '^[a-f0-9]{64}$'
            decisionId:
              type: 'string'
              pattern: '^decision_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$'
            confirmation:
              type: 'string'
              const: 'REPLACE_ACCEPTED_DATA'
          required:
            0: 'candidateRevision'
            1: 'manifestHash'
            2: 'reviewHash'
            3: 'expectedAcceptedReleaseId'
            4: 'dataPlanHash'
            5: 'decisionId'
            6: 'confirmation'
          additionalProperties: false
        CloseUnsentAcceptance:
          type: 'object'
          properties:
            requestHash:
              type: 'string'
              pattern: '^[a-f0-9]{64}$'
          required:
            0: 'requestHash'
          additionalProperties: false
        AbortAcceptance:
          type: 'object'
          properties:
            requestHash:
              type: 'string'
              pattern: '^[a-f0-9]{64}$'
            expectedPreparationRevision:
              type: 'integer'
              minimum: 1
              maximum: 9007199254740991
            reason:
              type: 'string'
              minLength: 1
              maxLength: 2000
            confirmation:
              type: 'string'
              const: 'ABORT_ACCEPTANCE_PREPARATION'
          required:
            0: 'requestHash'
            1: 'expectedPreparationRevision'
            2: 'reason'
            3: 'confirmation'
          additionalProperties: false
        AcceptanceBasis:
          type: 'object'
          properties:
            candidateRevision:
              type: 'integer'
              minimum: 1
              maximum: 9007199254740991
            manifestHash:
              type: 'string'
              pattern: '^[a-f0-9]{64}$'
            reviewHash:
              type: 'string'
              pattern: '^[a-f0-9]{64}$'
            expectedAcceptedReleaseId:
              anyOf:
                0:
                  type: 'string'
                  pattern: '^release_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$'
                1:
                  type: 'null'
            dataPlanHash:
              type: 'string'
              pattern: '^[a-f0-9]{64}$'
            projectId:
              type: 'string'
              pattern: '^prj_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$'
            runId:
              type: 'string'
              pattern: '^run_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$'
            candidateId:
              type: 'string'
              pattern: '^candidate_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$'
            codeCommit:
              type: 'string'
              pattern: '^[a-f0-9]{40}$'
            dataPlan:
              oneOf:
                0:
                  type: 'object'
                  properties:
                    schemaVersion:
                      type: 'string'
                      const: 'devmesh.data-plan.v1'
                    runId:
                      type: 'string'
                      pattern: '^run_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$'
                    codeCommit:
                      type: 'string'
                      pattern: '^[a-f0-9]{40}$'
                    requirementRevision:
                      type: 'integer'
                      minimum: 1
                      maximum: 9007199254740991
                    planRevision:
                      type: 'integer'
                      minimum: 1
                      maximum: 9007199254740991
                    templateVersion:
                      type: 'string'
                      pattern: '^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$'
                    checkConfigHash:
                      type: 'string'
                      pattern: '^[a-f0-9]{64}$'
                    strategy:
                      type: 'string'
                      const: 'INITIAL'
                    initialData:
                      type: 'string'
                      enum:
                        0: 'EMPTY'
                        1: 'DEMO'
                    sourceReleaseId:
                      type: 'null'
                    migrationRef:
                      type: 'null'
                    replacementDecisionId:
                      type: 'null'
                  required:
                    0: 'schemaVersion'
                    1: 'runId'
                    2: 'codeCommit'
                    3: 'requirementRevision'
                    4: 'planRevision'
                    5: 'templateVersion'
                    6: 'checkConfigHash'
                    7: 'strategy'
                    8: 'initialData'
                    9: 'sourceReleaseId'
                    10: 'migrationRef'
                    11: 'replacementDecisionId'
                  additionalProperties: false
                1:
                  type: 'object'
                  properties:
                    schemaVersion:
                      type: 'string'
                      const: 'devmesh.data-plan.v1'
                    runId:
                      type: 'string'
                      pattern: '^run_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$'
                    codeCommit:
                      type: 'string'
                      pattern: '^[a-f0-9]{40}$'
                    requirementRevision:
                      type: 'integer'
                      minimum: 1
                      maximum: 9007199254740991
                    planRevision:
                      type: 'integer'
                      minimum: 1
                      maximum: 9007199254740991
                    templateVersion:
                      type: 'string'
                      pattern: '^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$'
                    checkConfigHash:
                      type: 'string'
                      pattern: '^[a-f0-9]{64}$'
                    strategy:
                      type: 'string'
                      const: 'PRESERVE_MIGRATE'
                    initialData:
                      type: 'null'
                    sourceReleaseId:
                      type: 'string'
                      pattern: '^release_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$'
                    migrationRef:
                      type: 'object'
                      properties:
                        artifactId:
                          type: 'string'
                          pattern: '^artifact_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$'
                        sha256:
                          type: 'string'
                          pattern: '^[a-f0-9]{64}$'
                      required:
                        0: 'artifactId'
                        1: 'sha256'
                      additionalProperties: false
                    replacementDecisionId:
                      type: 'null'
                  required:
                    0: 'schemaVersion'
                    1: 'runId'
                    2: 'codeCommit'
                    3: 'requirementRevision'
                    4: 'planRevision'
