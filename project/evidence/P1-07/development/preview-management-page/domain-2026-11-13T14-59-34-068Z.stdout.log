    openapi: '3.1.0'
    jsonSchemaDialect: 'https://json-schema.org/draft/2020-12/schema'
    info:
      title: 'DevMesh 核心契约'
      version: '0.3.0'
      description: '共享命令、输入与需求理解 API。逐路由标记实现范围；离线代码与测试不代表企业身份、模型或产品全链路验收。其余 D3 API 随工作包增量补齐。'
    x-runtime-constraints:
      0: 'permit 有效期顺序、宿主当前代际及资源范围'
      1: '测试成果所有报告绑定相同 SHA'
      2: '事件 envelope 与 payload 版本和归属一致'
      3: 'ETag 安全整数范围'
      4: 'DAG 无环、来源存在、ACL、幂等及事务由后续服务负责'
    paths:
      /api/v1/projects:
        post:
          operationId: 'CreateProject'
          x-implementation-status: 'implemented-offline'
