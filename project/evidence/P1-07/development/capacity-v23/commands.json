{
  "executable": "D:\\Environments\\nodejs\\node.exe",
  "steps": [
    {
      "name": "frozen-install",
      "args": [
        "node_modules/pnpm/bin/pnpm.cjs",
        "install",
        "--frozen-lockfile",
        "--offline",
        "--ignore-scripts"
      ]
    },
    {
      "name": "typecheck",
      "args": [
        "node_modules/pnpm/bin/pnpm.cjs",
        "typecheck"
      ]
    },
    {
      "name": "lint",
      "args": [
        "node_modules/pnpm/bin/pnpm.cjs",
        "lint"
      ]
    },
    {
      "name": "current-build",
      "args": [
        "node_modules/pnpm/bin/pnpm.cjs",
        "--filter",
        "@devmesh/contracts",
        "--filter",
        "@devmesh/storage-sqlite",
        "--filter",
        "@devmesh/runner",
        "--filter",
        "@devmesh/platform-core",
        "-r",
        "run",
        "build"
      ]
    },
    {
      "name": "capacity",
      "args": [
        "--test",
        "--test-concurrency=1",
        "--test-reporter=tap",
        "tests/runner-preview-capacity.test.mjs",
        "tests/runner-upgrade.test.mjs"
      ]
    },
    {
      "name": "runner",
      "args": [
        "node_modules/pnpm/bin/pnpm.cjs",
        "test:runner"
      ]
    },
    {
      "name": "lifecycle",
      "args": [
        "--test",
        "--test-concurrency=1",
        "--test-reporter=tap",
        "tests/verification-preview-lifecycle.test.mjs"
      ]
    },
    {
      "name": "datasets",
      "args": [
        "--test",
        "--test-concurrency=1",
        "--test-reporter=tap",
        "tests/verification-datasets.test.mjs"
      ]
    },
    {
      "name": "preview-intents",
      "args": [
        "--test",
        "--test-concurrency=1",
        "--test-reporter=tap",
        "tests/verification-preview-intents.test.mjs",
        "tests/verification-dataset-paths.test.mjs"
      ]
    },
    {
      "name": "scheduler",
      "args": [
        "node_modules/pnpm/bin/pnpm.cjs",
        "test:scheduler"
      ]
    },
    {
      "name": "smoke",
      "args": [
        "node_modules/pnpm/bin/pnpm.cjs",
        "test:smoke"
      ]
    },
    {
      "name": "contracts",
      "args": [
        "node_modules/pnpm/bin/pnpm.cjs",
        "test:contracts"
      ]
    },
    {
      "name": "contracts-check",
      "args": [
        "node_modules/pnpm/bin/pnpm.cjs",
        "contracts:check"
      ]
    }
  ],
  "scope": "Exact validation driver command arrays; not a second execution."
}
