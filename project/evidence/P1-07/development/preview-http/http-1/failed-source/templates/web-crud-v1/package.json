{
  "name": "devmesh-template-web-crud-v1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": { "node": ">=24.9.0 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "pnpm run build:server && pnpm run build:web",
    "dataset:init": "node dist/server/main.js init",
    "start": "node dist/server/main.js serve",
    "test": "pnpm run build && vitest run --coverage",
    "test:e2e": "pnpm run build && playwright test",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run test:e2e"
  },
  "dependencies": { "express": "5.2.1", "react": "18.3.1", "react-dom": "18.3.1", "zod": "4.4.3" },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/express": "5.0.6",
    "@types/node": "24.13.1",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "26.1.0",
    "pnpm": "11.28.5",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
