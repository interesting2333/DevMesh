{
  "executable": "D:\\Environments\\nodejs\\node.exe",
  "steps": [
    {
      "name": "frozen-install",
      "args": [
        "node_modules/pnpm/bin/pnpm.cjs",
        "install",
        "--frozen-lockfile",
        "--offline",
        "--ignore-scripts"
      ]
    },
    {
      "name": "typecheck",
      "args": [
        "node_modules/pnpm/bin/pnpm.cjs",
