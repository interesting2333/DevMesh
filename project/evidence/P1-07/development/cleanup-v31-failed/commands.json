        "@devmesh/storage-sqlite",
        "--filter",
        "@devmesh/runner",
        "--filter",
        "@devmesh/platform-core",
        "--filter",
        "@devmesh/code-workspaces",
        "-r",
        "run",
        "build"
      ]
