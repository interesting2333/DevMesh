{
  "executable": "D:\\Environments\\nodejs\\node.exe",
  "steps": [
    {
      "name": "frozen-install",
      "args": [
        "node_modules/pnpm/bin/pnpm.cjs",
        "install",
        "--frozen-lockfile",
        "--offline",
        "--ignore-scripts"
      ]
    },
    {
      "name": "typecheck",
      "args": [
        "node_modules/pnpm/bin/pnpm.cjs",
        "typecheck"
      ]
    },
    {
      "name": "lint",
      "args": [
        "node_modules/pnpm/bin/pnpm.cjs",
        "lint"
      ]
    },
    {
      "name": "current-build",
      "args": [
        "node_modules/pnpm/bin/pnpm.cjs",
        "--filter",
        "@devmesh/contracts",
        "--filter",
        "@devmesh/storage-sqlite",
        "--filter",
        "@devmesh/runner",
        "--filter",
        "@devmesh/platform-core",
        "--filter",
        "@devmesh/code-workspaces",
        "-r",
        "run",
        "build"
      ]
    },
    {
      "name": "cleanup",
      "args": [
        "--test",
        "--test-concurrency=1",
        "--test-reporter=tap",
        "tests/runner-preview-cleanup.test.mjs"
      ]
    },
    {
      "name": "watchdog",
      "args": [
        "--test",
        "--test-concurrency=1",
        "--test-reporter=tap",
        "tests/runner-preview-watchdog.test.mjs"
      ]
    },
    {
      "name": "containers",
      "args": [
        "--test",
        "--test-concurrency=1",
        "--test-reporter=tap",
        "tests/runner-preview-container.test.mjs"
      ]
    },
    {
      "name": "capacity",
      "args": [
        "--test",
        "--test-concurrency=1",
        "--test-reporter=tap",
        "tests/runner-preview-capacity.test.mjs",
        "tests/runner-upgrade.test.mjs"
      ]
    }
  ],
  "scope": "Exact validation command arrays, not another execution."
}
