{
  "name": "@devmesh/platform-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.mts",
      "import": "./dist/scheduler.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/config.ts src/scheduler.ts --format esm --platform node --target node24 --dts --sourcemap --clean"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/cosmokit": "workspace:*",
    "@deepseek-ai/cordis-plugin-include": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:*",
    "express": "5.2.1",
    "@devmesh/blob-store": "workspace:*",
    "@devmesh/contracts": "workspace:*",
    "@devmesh/a2a-adapter": "workspace:*",
    "@devmesh/agent-runtime": "workspace:*",
    "@devmesh/mcp-tools": "workspace:*",
    "@devmesh/input-api": "workspace:*",
    "@devmesh/storage-sqlite": "workspace:*",
    "@devmesh/result-verifier": "workspace:*",
    "@devmesh/code-workspaces": "workspace:*"
  },
  "optionalDependencies": {
    "node-addon-require-builtin": "0.1.9"
  }
}
